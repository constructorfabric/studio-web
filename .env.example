# Copy to `.env` next to docker-compose.yml — compose reads it automatically.
# Everything here is optional: an empty value turns the matching feature off
# with a clear message instead of breaking the stack.

# Postgres superuser password for the bundled database.
STUDIO_PG_PASSWORD=studio

# OpenAI-compatible key for Ask AI, mini-chat and the Codex agent. The default
# profile points at Groq's free tier (console.groq.com -> API Keys, no card).
STUDIO_LLM_API_KEY=

# Anthropic key for the Claude Code agent inside IDE sessions. Not
# OpenAI-compatible: the agent talks to Anthropic directly, never through
# studio-llm-proxy.
STUDIO_ANTHROPIC_API_KEY=

# Encryption key for credstore secret values at rest (32 bytes, base64).
# THIS one is not optional in spirit: without it secret values do not survive
# `docker compose restart backend` — the backend logs a warning, falls back to
# the in-memory value store, and any PAT or connector token entered in the
# portal is gone. Generate it once and keep it; a new key makes previously
# stored values unreadable (they read as absent and must be entered again).
#   openssl rand -base64 32
STUDIO_CREDSTORE_KEY=

# ghcr credentials for pulling the Theia session image. A classic PAT with
# read:packages — an account password will not do.
STUDIO_REGISTRY_USER=
STUDIO_REGISTRY_TOKEN=

# External spec-quality detector service (studio-spec-quality gear).
# The service authenticates with its own shared bearer secret — set it here so
# the backend can call it; it never reaches the browser. Leave blank to keep
# analysis off. Optionally override the upstream base URL (a config default exists).
STUDIO_SPEC_QUALITY_API_KEY=
#STUDIO_SPEC_QUALITY_BASE_URL=https://349ddd50986c491c844d92fdaefcadfe.constructor.pro
