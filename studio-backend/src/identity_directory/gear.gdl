# Studio Identity Directory: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/identity_directory/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Identity Directory",
    description = "Platform-admin identity directory.",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/identity_directory/mod.rs",
    ),
    docs = docs(design = "../../../docs/design/studio-identity-directory.md"),
)
