# Studio Insight: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/insight/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Insight",
    description = "The integration seam to Constructor Insight (github.com/constructorfabric/insight, a decision-intelligence platform whose REST API is rooted at /api).",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/insight/mod.rs",
    ),
    docs = docs(design = "../../../docs/design/studio-insight.md"),
)
