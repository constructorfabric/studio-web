# Studio Environments: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/environments/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Environments",
    description = "Where an organization's products run (ADR-0043).",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/environments/mod.rs",
    ),
)
