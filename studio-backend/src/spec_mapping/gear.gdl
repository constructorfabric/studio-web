# Studio Spec Mapping: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/spec_mapping/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Spec Mapping",
    description = "From a project's specification to the gears that build it.",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/spec_mapping/mod.rs",
    ),
    docs = docs(design = "../../../docs/design/studio-spec-mapping.md"),
)
