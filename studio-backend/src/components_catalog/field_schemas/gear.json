 "repo": "constructorfabric/gears-rust",
 "sourceClasses": {
  "repo": {
   "label": "In the tree",
   "hint": "Read from a file at the pinned commit."
  },
  "api": {
   "label": "GitHub or crates.io",
   "hint": "Read from the GitHub API, tags, or the registry."
  },
  "manual": {
   "label": "Manual entry",
   "hint": "No file holds it; someone records it once."
  },
  "none": {
   "label": "No source",
   "hint": "Nothing in the repository defines it today."
  },
  "engine": {
   "label": "Gearbox engine",
   "hint": "Projected by the Gearbox engine from the gear.gdl and the #[toolkit::gear] attribute, at the corpus named on the page."
  },
  "project": {
   "label": "Roadmap board",
   "hint": "Read from the GitHub Project the gears are planned on: the item matched to this gear by title, or the one pinned in its roadmap item field."
  },
  "rule": {
   "label": "Quality rule",
   "hint": "Computed from this page's other fields by the quality criteria; nothing is read for it."
  }
 },
