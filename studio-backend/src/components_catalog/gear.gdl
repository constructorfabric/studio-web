# Studio Components Catalogue: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/components_catalog/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Components Catalogue",
    description = "A connector to crates.io that catalogues \"our gears\".",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/components_catalog/mod.rs",
    ),
    docs = docs(design = "../../../docs/design/studio-components-catalog.md"),
)
