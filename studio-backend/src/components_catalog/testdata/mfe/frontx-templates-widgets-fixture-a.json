        "gts.frontx.mfes.comm.action.v1~frontx.mfes.ext.unmount_ext.v1~"
      ],
      "manifest": "gts.frontx.mfes.mfe.mf_manifest.v1~frontx.widgets.fixture_a.manifest.v1",
      "exposedModule": "./lifecycle"
    }
  ],
  "extensions": [
    {
      "id": "gts.frontx.mfes.ext.extension.v1~frontx.widgets.fixture_a.widget_alpha.v1",
      "domain": "gts.frontx.mfes.ext.domain.v1~frontx.widgets.area.main.v1",
      "entry": "gts.frontx.mfes.mfe.entry.v1~frontx.mfes.mfe.entry_mf.v1~frontx.widgets.fixture_a.entry.v1",
