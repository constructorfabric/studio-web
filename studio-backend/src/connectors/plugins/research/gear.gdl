# Research Connector Plugin: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/connectors/plugins/research/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Research Connector Plugin",
    description = "The Constructor Research driver of studio-connector (ADR-0049), registered under its connector plugin point. Signed in to through the Constructor identity provider.",
    category = "core-platform-integration",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../../../..",
        attr = "src/connectors/plugins/research/mod.rs",
    ),
    implements = "cf.studio.connector.plugin.v1~",
    # The vendor studio-connector selects drivers by, the priority among
    # drivers of one vendor, the identity provider client Studio signs in as,
    # and where Research's integration service is.
    config_schema = config(rust = "Config", exposes = ["vendor", "priority", "issuer", "client_id", "client_secret", "scope", "redirect_uri", "api_url"]),
)
