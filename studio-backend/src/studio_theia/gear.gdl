# Studio Theia Bridge: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/studio_theia/gear.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Theia Bridge",
    description = "The backend-to-backend bridge to the Theia node backend of an IDE session (ADR-0022), linked with the theia-bridge feature.",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/studio_theia/gear.rs",
        features = ["theia-bridge"],
    ),
)
