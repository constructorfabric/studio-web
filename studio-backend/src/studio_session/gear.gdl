# Studio Session: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/studio_session/gear.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Session",
    description = "Per-workspace Theia IDE sessions: start, reach and stop a person's IDE container.",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/studio_session/gear.rs",
    ),
    docs = docs(design = "../../../docs/design/studio-session.md"),
)
