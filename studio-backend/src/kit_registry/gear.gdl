# Studio Kits: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/kit_registry/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Kits",
    description = "The Git-backed kit catalogue, and the kits each project wants installed.",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/kit_registry/mod.rs",
    ),
    docs = docs(design = "../../../docs/design/studio-kits.md"),
)
