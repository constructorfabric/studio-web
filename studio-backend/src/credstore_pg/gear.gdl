# Studio Credstore on PostgreSQL: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/credstore_pg/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Credstore on PostgreSQL",
    description = "A credstore value-store plugin that survives a restart.",
    category = "core-platform-integration",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/credstore_pg/mod.rs",
    ),
    implements = "cf.core.credstore.plugin.v1~",
    docs = docs(design = "../../../docs/design/studio-credstore-pg.md"),
)
