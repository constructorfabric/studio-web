# Studio Domain Model: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/domain_model/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Domain Model",
    description = "Store the Studio domain model as GTS types in Graph Storage, create objects of those types, extend the types, and read the model back so the frontend can be regenerated from it.",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/domain_model/mod.rs",
    ),
    docs = docs(design = "../../../docs/design/studio-domain-model.md"),
)
