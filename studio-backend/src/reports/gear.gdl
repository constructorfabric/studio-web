# Studio Reports: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/reports/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Reports",
    description = "The reports a Studio draws, and where each one's data comes from in an organization (ADR-0033).",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/reports/mod.rs",
    ),
    docs = docs(design = "../../../docs/design/studio-reports.md"),
)
