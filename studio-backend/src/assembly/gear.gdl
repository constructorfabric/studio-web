# Studio Assembly: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/assembly/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Assembly",
    description = "What this backend is made of, said by the backend itself.",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/assembly/mod.rs",
    ),
    docs = docs(design = "../../../docs/design/studio-assembly.md"),
)
