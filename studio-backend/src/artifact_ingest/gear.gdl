# Studio Artifact Ingest: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/artifact_ingest/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Artifact Ingest",
    description = "Pull issues, pull requests and files from a connector source into the graph as typed GTS nodes.",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/artifact_ingest/mod.rs",
    ),
    docs = docs(design = "../../../docs/design/studio-artifact-ingest.md"),
)
