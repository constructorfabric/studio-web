# Studio Usage: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/usage/mod.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Usage",
    description = "What Studio's model calls and IDE sessions use, and what it costs an organization (issue #781).",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/usage/mod.rs",
    ),
    docs = docs(design = "../../../docs/design/studio-usage.md"),
)
