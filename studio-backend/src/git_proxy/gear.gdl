# Studio Git: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/git_proxy/gear.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio Git",
    description = "The Git remote a desktop session clones from (ADR-0027 §3).",
    category = "core-functionality",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/git_proxy/gear.rs",
    ),
    docs = docs(design = "../../../docs/design/studio-git.md"),
)
