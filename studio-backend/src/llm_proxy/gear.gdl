# Studio LLM Proxy: what Gearbox needs to place it in a product.
#
# Projected from #[toolkit::gear] in src/llm_proxy/gear.rs, so not written here: the id,
# the capabilities, the co-located dependencies. Every Studio gear is a
# module of the one cf-studio-backend crate; `attr` names the file the
# attribute is in.

gear(
    maturity = "preview",
    name = "Studio LLM Proxy",
    description = "Studio's one way out to a model provider, on a person's key.",
    category = "gen-ai",
    visibility = "internal",
    package = cargo(
        crate_name = "cf-studio-backend",
        lib = "cf_studio_backend",
        path = "../..",
        attr = "src/llm_proxy/gear.rs",
    ),
    docs = docs(design = "../../../docs/design/studio-llm-proxy.md"),
)
