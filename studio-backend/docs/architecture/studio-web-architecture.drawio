        <mxCell id="p2-own-10" value="studio-kits &lt;i&gt;— git-каталог китов&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-own"><mxGeometry y="300" width="290" height="30" as="geometry" /></mxCell>
        <mxCell id="p2-own-11" value="studio-insight &lt;i&gt;— шов к Constructor Insight&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-own"><mxGeometry y="330" width="290" height="30" as="geometry" /></mxCell>
        <mxCell id="p2-own-12" value="studio-spec-quality" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-own"><mxGeometry y="360" width="290" height="30" as="geometry" /></mxCell>
        <mxCell id="p2-own-13" value="studio-llm-proxy &lt;i&gt;— для Theia AI&lt;/i&gt; &lt;b&gt;*llm&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;fontColor=#B85450;" vertex="1" parent="p2-own"><mxGeometry y="390" width="290" height="30" as="geometry" /></mxCell>
        <mxCell id="p2-own-14" value="studio-secrets-bootstrap &lt;i&gt;— самолечение секретов&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-own"><mxGeometry y="420" width="290" height="30" as="geometry" /></mxCell>

        <mxCell id="p2-own-15" value="studio-tasks &lt;i&gt;— durable-очередь фоновых работ&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-own"><mxGeometry y="450" width="290" height="30" as="geometry" /></mxCell>
        <mxCell id="p2-own-16" value="studio-scheduler &lt;i&gt;— расписания, ставит в очередь&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-own"><mxGeometry y="480" width="290" height="30" as="geometry" /></mxCell>
        <mxCell id="p2-own-17" value="studio-notify &lt;i&gt;— доставка в чат-платформы&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-own"><mxGeometry y="510" width="290" height="30" as="geometry" /></mxCell>
        <mxCell id="p2-plug" value="Плагины: выбор по vendor + priority&lt;br&gt;(МЕНЬШЕ ЧИСЛО = ВЫИГРЫВАЕТ)" style="swimlane;whiteSpace=wrap;html=1;childLayout=stackLayout;horizontal=1;startSize=45;horizontalStack=0;resizeParent=0;collapsible=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="880" y="90" width="250" height="405" as="geometry" />
        </mxCell>
        <mxCell id="p2-plug-1" value="&lt;b&gt;authn&lt;/b&gt;: static-authn ↔ oidc-authn" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-plug"><mxGeometry y="45" width="250" height="30" as="geometry" /></mxCell>
        <mxCell id="p2-plug-2" value="&lt;b&gt;authz&lt;/b&gt;: static-authz (100)" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-plug"><mxGeometry y="75" width="250" height="30" as="geometry" /></mxCell>
        <mxCell id="p2-plug-3" value="&lt;b&gt;authz&lt;/b&gt;: studio-authz-plugin (40) ⇐ активен&lt;br&gt;&lt;i&gt;секции нет ни в одном профиле&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;fontColor=#B85450;" vertex="1" parent="p2-plug"><mxGeometry y="105" width="250" height="40" as="geometry" /></mxCell>
        <mxCell id="p2-plug-4" value="&lt;b&gt;IdP&lt;/b&gt;: static-idp (echo) ↔ keycloak-idp" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-plug"><mxGeometry y="145" width="250" height="30" as="geometry" /></mxCell>
        <mxCell id="p2-plug-5" value="&lt;b&gt;credstore value-store&lt;/b&gt;: static (в памяти!)&lt;br&gt;↔ studio-credstore-pg (PG, AES-256-GCM)" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-plug"><mxGeometry y="175" width="250" height="40" as="geometry" /></mxCell>
        <mxCell id="p2-plug-6" value="&lt;b&gt;tenant-resolver&lt;/b&gt;: плагин, живущий&lt;br&gt;внутри account-management" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-plug"><mxGeometry y="215" width="250" height="40" as="geometry" /></mxCell>
        <mxCell id="p2-plug-7" value="&lt;b&gt;connector-драйверы&lt;/b&gt; (наши, 11):&lt;br&gt;github · gitlab · bitbucket · openai · anthropic&lt;br&gt;slack · zulip · discord (+ webhook-варианты)" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-plug"><mxGeometry y="255" width="250" height="40" as="geometry" /></mxCell>
        <mxCell id="p2-plug-8" value="&lt;b&gt;model policy · audit&lt;/b&gt;: static (в mini-chat)" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-plug"><mxGeometry y="295" width="250" height="30" as="geometry" /></mxCell>
        <mxCell id="p2-plug-9" value="&lt;i&gt;Выключить плагин можно только проиграв&lt;br&gt;по priority — линковка и есть активация.&lt;br&gt;Конвенция: победитель 40–100,&lt;br&gt;проигравший 1000+&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p2-plug"><mxGeometry y="325" width="250" height="70" as="geometry" /></mxCell>

        <mxCell id="p2-feat" value="&lt;b&gt;Feature-флаги (Cargo.toml)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;default = [llm, graph]&lt;/b&gt; — cargo run и docker compose&lt;br&gt;&lt;b&gt;llm&lt;/b&gt; → mini-chat + oagw (и studio-llm-proxy)&lt;br&gt;&lt;b&gt;graph&lt;/b&gt; → graph-storage (эмбеддинги onnx и remote)&lt;br&gt;&lt;b&gt;theia-bridge&lt;/b&gt; → studio-theia (opt-in)&lt;br&gt;&lt;b&gt;theia-event-broker&lt;/b&gt; ⊃ theia-bridge&lt;br&gt;&lt;br&gt;&lt;b&gt;Релизный образ (studio-delivery.yml:461):&lt;/b&gt;&lt;br&gt;--no-default-features --features graph,theia-bridge&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;⇒ в проде НЕТ mini-chat / oagw / llm-proxy.&lt;br&gt;Причина: post_init у oagw провижинит upstream под root-тенантом,&lt;br&gt;а root создаёт сага account-management в run-фазе → на свежей БД дедлок.&lt;/font&gt;&lt;br&gt;&lt;br&gt;CI компилирует обе комбинации отдельно (:166-167):&lt;br&gt;--features theia-bridge и --no-default-features." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;align=left;spacingLeft=8;size=16;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="390" width="490" height="230" as="geometry" />
        </mxCell>

        <mxCell id="p2-patch" value="&lt;b&gt;Откуда берутся зависимости&lt;/b&gt;&lt;br&gt;&lt;br&gt;Все cf-gears-* объявлены на constructorfabric/gears-rust @ main,&lt;br&gt;но блок &lt;b&gt;[patch]&lt;/b&gt; в конце Cargo.toml уводит КАЖДЫЙ из них&lt;br&gt;на форк vasylcf/gears-rust, тег cf-gears-graph-storage-v0.1.1 —&lt;br&gt;иначе в бинаре окажутся две копии toolkit, и он не слинкуется.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#B85450&quot;&gt;Пока патч висит, платформу нельзя двигать по main.&lt;br&gt;Снимаем, когда graph-storage уедет в upstream (нужен PR #4639).&lt;/font&gt;&lt;br&gt;&lt;br&gt;Точные коммиты фиксирует Cargo.lock; сборки идут с --locked." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;align=left;spacingLeft=8;size=16;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="650" width="490" height="200" as="geometry" />
        </mxCell>

        <mxCell id="p2-gts" value="&lt;b&gt;Два реестра смысла (ADR-0013)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;types-registry&lt;/b&gt; — каталог: что вообще существует.&lt;br&gt;&lt;b&gt;graph-storage&lt;/b&gt; — контракты: схемы узлов и рёбер графа.&lt;br&gt;&lt;br&gt;Согласованность держится тремя вещами:&lt;br&gt;• &lt;b&gt;gts-types&lt;/b&gt; — офлайн-инвентарь из кода → docs/gts-types.json&lt;br&gt;• &lt;b&gt;cargo test gts_inventory&lt;/b&gt; — дрейф снапшота, полнота профилей,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;грамматика идентификаторов, отсутствие расхождений реестров&lt;br&gt;• &lt;b&gt;gts-audit --base-url …&lt;/b&gt; — диф живого стенда с инвентарём;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;ненулевой код выхода ⇒ годится в гейт деплоя&lt;br&gt;&lt;br&gt;Схема зарегистрированного типа неизменяема: правка = миграция графа.&lt;br&gt;Исключения (живут только в таблицах гира): gts.cf.studio.doc.*" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;align=left;spacingLeft=8;size=16;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="560" y="660" width="570" height="250" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="3 · Данные, профили, ловушки" id="runtime">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="p3-title" value="&lt;b&gt;Где что лежит, чем отличаются профили и на чём мы уже обожглись&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="700" height="40" as="geometry" />
        </mxCell>

        <mxCell id="p3-store" value="Хранилища" style="swimlane;whiteSpace=wrap;html=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=0;collapsible=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="330" height="270" as="geometry" />
        </mxCell>
        <mxCell id="p3-store-1" value="&lt;b&gt;sqlite_main&lt;/b&gt; — только config/dev.yaml&lt;br&gt;&lt;i&gt;~9 гиров; второй диалект миграций&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p3-store"><mxGeometry y="30" width="330" height="40" as="geometry" /></mxCell>
        <mxCell id="p3-store-2" value="&lt;b&gt;pg_main — PostgreSQL 19 + pgvector&lt;/b&gt;&lt;br&gt;&lt;i&gt;одна БД на гир, граф там же (#94); в k8s создаются заранее&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p3-store"><mxGeometry y="70" width="330" height="40" as="geometry" /></mxCell>
        <mxCell id="p3-store-3" value="&lt;b&gt;graph-storage&lt;/b&gt; — в том же сервере&lt;br&gt;&lt;i&gt;отдельного pg_graph больше нет; миграции идут в boot&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p3-store"><mxGeometry y="110" width="330" height="40" as="geometry" /></mxCell>
        <mxCell id="p3-store-4" value="&lt;b&gt;studio_credstore_values&lt;/b&gt; (PG)&lt;br&gt;&lt;i&gt;значения секретов, AES-256-GCM (issue #66)&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p3-store"><mxGeometry y="150" width="330" height="40" as="geometry" /></mxCell>
        <mxCell id="p3-store-5" value="&lt;b&gt;S3 · Virtuozzo&lt;/b&gt; — file-storage&lt;br&gt;&lt;i&gt;org / workspace / project&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p3-store"><mxGeometry y="190" width="330" height="40" as="geometry" /></mxCell>
        <mxCell id="p3-store-6" value="&lt;b&gt;Keycloak&lt;/b&gt; — пользователи и атрибут tenant_id" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p3-store"><mxGeometry y="230" width="330" height="30" as="geometry" /></mxCell>

        <mxCell id="p3-prof" value="Профили конфигурации (config/*.yaml)" style="swimlane;whiteSpace=wrap;html=1;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=0;collapsible=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="400" y="80" width="420" height="270" as="geometry" />
        </mxCell>
        <mxCell id="p3-prof-1" value="&lt;b&gt;dev.yaml&lt;/b&gt; — SQLite, static-authn, static-idp&lt;br&gt;&lt;i&gt;550 строк · 27 секций гиров · без внешних зависимостей&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p3-prof"><mxGeometry y="30" width="420" height="40" as="geometry" /></mxCell>
        <mxCell id="p3-prof-2" value="&lt;b&gt;postgres.yaml&lt;/b&gt; — PG с хоста, static-authn&lt;br&gt;&lt;i&gt;575 строк · 30 секций гиров&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p3-prof"><mxGeometry y="70" width="420" height="40" as="geometry" /></mxCell>
        <mxCell id="p3-prof-3" value="&lt;b&gt;docker.yaml&lt;/b&gt; — всё в compose, keycloak-idp&lt;br&gt;&lt;i&gt;740 строк · 34 секции гиров · bind 0.0.0.0&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p3-prof"><mxGeometry y="110" width="420" height="40" as="geometry" /></mxCell>
        <mxCell id="p3-prof-4" value="&lt;b&gt;oidc.yaml&lt;/b&gt; — Keycloak-логин, реальный провижининг&lt;br&gt;&lt;i&gt;751 строка · 44 секции гиров · дневной драйвер разработки&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p3-prof"><mxGeometry y="150" width="420" height="40" as="geometry" /></mxCell>
        <mxCell id="p3-prof-5" value="&lt;b&gt;k8s.yaml&lt;/b&gt; — кластерный профиль (Virtuozzo)&lt;br&gt;&lt;i&gt;684 строки · 33 секции гиров · БД и секреты снаружи&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p3-prof"><mxGeometry y="190" width="420" height="40" as="geometry" /></mxCell>
        <mxCell id="p3-prof-6" value="&lt;font color=&quot;#B85450&quot;&gt;Профили — не пять копий: 56% настроек есть не везде&lt;br&gt;(в dev нет 20 секций, которые есть в oidc).&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;spacingLeft=6;overflow=hidden;whiteSpace=wrap;" vertex="1" parent="p3-prof"><mxGeometry y="230" width="420" height="40" as="geometry" /></mxCell>

        <mxCell id="p3-cicd" value="&lt;b&gt;Сборка и доставка&lt;/b&gt;&lt;br&gt;&lt;br&gt;ci.yml — сборка + тесты на PR&lt;br&gt;release.yml — тег v* → образы в ghcr&lt;br&gt;deploy.yml — кластеры studio-dev / studio-test (Virtuozzo)&lt;br&gt;deploy/helm/studio-web — Postgres и IdP только через готовые Secrets&lt;br&gt;&lt;br&gt;Конвейер Constructor:&lt;br&gt;GitHub → зеркало GitLab → Harbor → Argo CD" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;align=left;spacingLeft=8;size=16;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="850" y="80" width="280" height="270" as="geometry" />
        </mxCell>

        <mxCell id="p3-life" value="&lt;b&gt;Фазы жизненного цикла гира&lt;/b&gt;&lt;br&gt;&lt;br&gt;pre_init → db (миграции) → init → post_init → rest (регистрация роутов) → grpc → start → … → stop&lt;br&gt;&lt;br&gt;Порядок между гирами — топологическая сортировка по deps. Внутри фазы гиры идут ПОСЛЕДОВАТЕЛЬНО." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;align=left;spacingLeft=8;size=16;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="380" width="1090" height="120" as="geometry" />
        </mxCell>

        <mxCell id="p3-traps" value="&lt;b&gt;Ловушки, за которые уже заплачено&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;start не должен блокировать&lt;/b&gt; — иначе гиры после тебя не стартуют и порт не биндится. tokio::spawn и return.&lt;br&gt;2. &lt;b&gt;Приоритет плагина инвертирован&lt;/b&gt; — выигрывает меньшее число.&lt;br&gt;3. &lt;b&gt;Активация в link-time&lt;/b&gt; — конфигурируй каждый прилинкованный плагин в каждом профиле; отключай приоритетом, не отсутствием секции.&lt;br&gt;4. &lt;b&gt;Статический credstore держит значения В ПАМЯТИ&lt;/b&gt; — метаданные в PG, значения нет: после рестарта секрет существует (409 на create), но не читается. Ради этого и написан studio-credstore-pg.&lt;br&gt;5. &lt;b&gt;Keycloak 26 выбрасывает unmanaged-атрибуты&lt;/b&gt;, записанные через Admin API, без unmanagedAttributePolicy: ENABLED → приглашённый пользователь получает 401 (нет claim tenant_id).&lt;br&gt;6. &lt;b&gt;404 на барьере — это дизайн&lt;/b&gt;: тенант, ставший self_managed, отрезает своё поддерево от админов предка.&lt;br&gt;7. &lt;b&gt;OperationBuilder&lt;/b&gt;: ответ регистрируется ДО error_*; для 204 — no_content_response.&lt;br&gt;8. &lt;b&gt;api-gateway по умолчанию слушает loopback&lt;/b&gt; — контейнерам сессий нужен bind_addr 0.0.0.0 (аутентификация всё равно на каждом запросе)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffff;align=left;spacingLeft=8;size=16;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="40" y="530" width="1090" height="300" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
