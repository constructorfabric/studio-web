# NB deliberately no `# syntax=docker/dockerfile:1.7` line: that directive
# makes every build start by resolving the frontend image from Docker Hub,
# and nothing here needs a feature the builder's own frontend lacks (no
# heredocs, no cache mounts). Dropping it means a build with warm base-image
# layers needs no registry at all — which also keeps a broken credential
# helper from failing the build before it starts.
# Build the Studio backend FROM SOURCE inside Docker (one-click compose path).
# Build context is the studio-web directory: every gear is a crates.io
# dependency pinned in Cargo.lock, so cargo fetches it and no sibling checkout
# has to be copied into the image.
# CI uses the plain ./Dockerfile with a prebuilt binary instead.

# Dependencies and our own code are built in separate layers (cargo-chef).
# Almost all of the time goes into the 28 gears crates and their tree, which
# change only when Cargo.toml or Cargo.lock does — so that layer is reused
# across every rebuild where only src/ moved, locally and in CI alike.
#
# NB this belongs HERE and not in the gears repository: cargo does not reuse
# another workspace's target directory, so an image that pre-builds the gears
# workspace would speed up nothing on our side. What is cacheable is OUR
# dependency graph, and it is described by our lockfile.
FROM rust:1.97-bookworm@sha256:0e2bcaef56d041a486784e54104a81aebe0da44bd03019bd70bc0401e42e4a97 AS chef
# libprotobuf-dev ships the well-known types (google/protobuf/empty.proto …)
# that gears-rust SDK protos import; protoc alone fails without them.
RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler libprotobuf-dev cmake \
 && rm -rf /var/lib/apt/lists/* \
 && cargo install cargo-chef --version 0.1.78 --locked
WORKDIR /src/studio-backend

# The recipe is a dependency-only projection of the manifest: it changes when
# dependencies change and not when our sources do.
FROM chef AS planner
COPY studio-backend/ .
# Cargo.lock is the source of truth for every gear's version and every other
# registry dependency. Do not run `cargo update` in an image build: it would
# silently produce a binary different from the checked-in source tree.
RUN cargo chef prepare --recipe-path recipe.json

FROM chef AS build
COPY --from=planner /src/studio-backend/recipe.json recipe.json
# No cache mounts here on purpose: the compiled dependencies must live in the
# image layer, which is what makes the cache shareable (GHA, another machine)
# rather than local to one BuildKit daemon.
# The generated recipe includes the committed lockfile. `cargo chef cook`
# therefore resolves the same dependency graph without a separate update step.
# A vendored plugin is a path dependency outside the recipe's skeletons, so the
# cook needs its source; without it the build stops at "failed to read
# plugins/…/Cargo.toml".
COPY studio-backend/plugins/ plugins/
RUN cargo chef cook --release --recipe-path recipe.json
COPY studio-backend/ .
# The gear designs, for studio-assembly: build.rs compiles each one's purpose
# into the binary (../docs/design from here). After the cook, so editing a
# design never invalidates the dependency layer.
COPY docs/design/ /src/docs/design/

# The commit, when the caller knows it (`--build-arg STUDIO_BUILD_COMMIT=$(git
# rev-parse HEAD)`); compose does not pass it, and the manifest then says null.
ARG STUDIO_BUILD_COMMIT=""
# CARGO_FEATURES picks the cargo features of the binary (compose passes
# `--features theia-bridge`). Default is empty = the default features, `llm`
# and `graph`. The cargo-chef dep layer above is unchanged by it, so every
# variant shares it and only the final app compile differs.
ARG CARGO_FEATURES=""
RUN cargo build --locked --release ${CARGO_FEATURES} \
 && cp target/release/studio-backend /studio-backend

# ONNX Runtime, for the graph-storage gear's in-process embedding provider.
# The gear's `ort` crate is pinned `load-dynamic`: nothing links the runtime at
# build time, it is dlopen'ed at first use from ORT_DYLIB_PATH. The library
# version is bound to that crate pin (api-24 → 1.29.x), so it belongs in the
# image beside the binary; the model artifacts do NOT — they are deployment
# data and arrive through the models volume (see docker-compose.yml).
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS onnxruntime
ARG ONNXRUNTIME_VERSION=1.29.0
ARG ONNXRUNTIME_SHA256=c3fddc4f139a045b0c4902c57410f0694f1c2fdf9b6939fbe38b1aeae7cd14ba
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && curl -sSL --fail -o /tmp/onnxruntime.tgz \
      "https://github.com/microsoft/onnxruntime/releases/download/v${ONNXRUNTIME_VERSION}/onnxruntime-linux-x64-${ONNXRUNTIME_VERSION}.tgz" \
 && echo "${ONNXRUNTIME_SHA256}  /tmp/onnxruntime.tgz" | sha256sum --check \
 && mkdir -p /opt/onnxruntime \
 && tar xzf /tmp/onnxruntime.tgz -C /opt/onnxruntime --strip-components=1 \
 && rm /tmp/onnxruntime.tgz

# Helm, for deploys to an organization's environments (environments/deploy.rs,
# ADR-0043): the server installs a product's generated chart with the
# environment's connection, so a member's machine never holds a cluster
# credential. Pinned with the checksum get.helm.sh publishes next to it.
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS helm
ARG HELM_VERSION=v3.18.4
ARG HELM_SHA256=f8180838c23d7c7d797b208861fecb591d9ce1690d8704ed1e4cb8e2add966c1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && curl -sSL --fail -o /tmp/helm.tgz "https://get.helm.sh/helm-${HELM_VERSION}-linux-amd64.tar.gz" \
 && echo "${HELM_SHA256}  /tmp/helm.tgz" | sha256sum --check \
 && tar xzf /tmp/helm.tgz -C /tmp linux-amd64/helm \
 && install -m 0755 /tmp/linux-amd64/helm /usr/local/bin/helm \
 && rm -rf /tmp/helm.tgz /tmp/linux-amd64

# The Gearbox engine behind the gear catalogue and product previews
# (product/gearbox.rs), downloaded from the same constructorfabric/gearbox
# release as studio-backend/Dockerfile and the session image's `gearbox` stage
# (theia/Dockerfile), which the desktop build reads too: the portal, the IDE
# and the desktop must say the same thing about the same product.gdl, so move
# all three together. theia/Dockerfile says why it is a release and not a
# build. The archive is checked against the SHA-256 from the release's
# SHA256SUMS; the binary is built for glibc 2.35 and runs on the runtime below.
FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171 AS gearbox
# Until constructorfabric/gearbox#17 (GDL 1.5, `frontend = frontx_product(...)`)
# merges, the engine is the snapshot of that PR's branch on its author's fork;
# move back to a constructorfabric/gearbox release once it does.
ARG STUDIO_GEARBOX_REPO=https://github.com/AndrejK666/gearbox
ARG STUDIO_GEARBOX_RELEASE=snapshot-f2deac5
ARG STUDIO_GEARBOX_VERSION=0.1.0-f2deac5
ARG STUDIO_GEARBOX_REF=f2deac58fee0144ad418abdd36abbc5d378e1474
ARG STUDIO_GEARBOX_SHA256=acc86bffdde0417c91dfad0e3358ac14cd65953599ca72ca18c056110b62b305
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/* \
 && name="gearbox-${STUDIO_GEARBOX_VERSION}-x86_64-unknown-linux-gnu" \
 && curl -sSL --fail -o /tmp/gearbox.tar.gz \
      "${STUDIO_GEARBOX_REPO}/releases/download/${STUDIO_GEARBOX_RELEASE}/${name}.tar.gz" \
 && echo "${STUDIO_GEARBOX_SHA256}  /tmp/gearbox.tar.gz" | sha256sum --check \
 && tar xzf /tmp/gearbox.tar.gz -C /tmp \
 && install -m 0755 "/tmp/${name}/gearbox" /usr/local/bin/gearbox \
 && mkdir -p /usr/local/share/gearbox \
 && echo "${STUDIO_GEARBOX_REF}" > /usr/local/share/gearbox/REVISION \
 && rm -rf /tmp/gearbox.tar.gz "/tmp/${name}" \
 && gearbox --version

FROM debian:bookworm-slim@sha256:88200866dfff7ea7f5cbcb6ec7c8a701889efe6fe859fe64d6990e4b07ea4171
# gosu drops privileges in the entrypoint without the signal-forwarding and
# TTY quirks of su/sudo — the process it execs stays PID 1.
# git: the artifact-ingest gear shells out to it to clone repositories into the
# artifacts volume (STUDIO_ARTIFACT_WORKDIR) and walk their files.
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gosu git \
 && rm -rf /var/lib/apt/lists/* \
 && groupadd --gid 1000 studio \
 && useradd --system --uid 1000 --gid 1000 --create-home --home /app studio
COPY --from=onnxruntime /opt/onnxruntime/lib/libonnxruntime.so* /opt/onnxruntime/lib/
ENV ORT_DYLIB_PATH=/opt/onnxruntime/lib/libonnxruntime.so
# uid/gid 1000 is not cosmetic: workspace directories this server creates are
# bind-mounted into the Theia session containers, which run as `node` (uid
# 1000) and must be able to write clones into them. A `--system` uid would
# leave every workspace read-only for the IDE.
WORKDIR /app
COPY --from=build /studio-backend /app/studio-backend
COPY --from=gearbox /usr/local/bin/gearbox /usr/local/bin/gearbox
# Its commit, which `gearbox --version` does not say (studio-product reads it).
COPY --from=gearbox /usr/local/share/gearbox/REVISION /usr/local/share/gearbox/REVISION
# The engine above reads GDL 1.5, and pipelines install it from the same repository.
ENV STUDIO_GEARBOX_REPO=https://github.com/AndrejK666/gearbox \
    STUDIO_GEARBOX_FRONTX=1
COPY --from=helm /usr/local/bin/helm /usr/local/bin/helm
COPY studio-backend/config/ /app/config/
COPY studio-backend/docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chown -R studio /app \
 && chmod +x /usr/local/bin/entrypoint.sh
# Stays root: the entrypoint needs it to join the Docker socket's group, and
# hands the server to `studio` via gosu as its last act.
EXPOSE 8090
HEALTHCHECK --interval=10s --timeout=3s --retries=10 \
  CMD curl -sf http://127.0.0.1:8090/cf/health || exit 1
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["--config", "/app/config/docker.yaml", "run"]
