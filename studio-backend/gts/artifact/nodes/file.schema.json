{
  "$id": "gts://gts.cf.studio.artifact.file.v1~",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "File",
  "description": "A file in a repository tree (from the clone).",
  "type": "object",
  "properties": {
    "repo": { "type": "string", "description": "repo instance id." },
    "path": { "type": "string" },
    "blob_sha": { "type": ["string", "null"] },
    "size": { "type": ["integer", "null"] },
    "language": { "type": ["string", "null"] },
    "content_type": { "type": ["string", "null"] },
    "mode": { "type": ["string", "null"] },
    "commit_sha": { "type": ["string", "null"] }
  },
  "required": ["repo", "path"],
  "additionalProperties": false
}
