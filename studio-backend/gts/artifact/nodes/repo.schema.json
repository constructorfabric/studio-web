{
  "$id": "gts://gts.cf.studio.artifact.repo.v1~",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Repository",
  "description": "A source repository ingested from a connector (the artifact source).",
  "type": "object",
  "properties": {
    "connector_id": { "type": "string", "description": "Connection id in the tenant catalogue." },
    "provider": { "type": "string", "description": "github | gitlab | bitbucket." },
    "full_path": { "type": "string", "description": "Namespaced path, e.g. org/repo." },
    "url": { "type": "string" },
    "default_branch": { "type": ["string", "null"] },
    "commit_sha": { "type": ["string", "null"], "description": "Head commit at ingest time (snapshot key)." },
    "cloned_at": { "type": ["string", "null"], "format": "date-time" },
    "volume_ref": { "type": ["string", "null"], "description": "Content-addressed clone volume ref." }
  },
  "required": ["connector_id", "provider", "full_path"],
  "additionalProperties": false
}
