# Rendered to /etc/nginx/conf.d/default.conf at container start by the nginx
# image's envsubst step (/etc/nginx/templates/*.template). BACKEND_HOST makes
# the /cf upstream deployment-agnostic: compose sets studio-backend:8090, the
# Helm chart sets <release>-backend:8090. A literal hostname here would make
# nginx REFUSE TO START in any environment where the name doesn't resolve.
# NB envsubst only substitutes DEFINED env vars (BACKEND_HOST), so nginx's own
# $host / $http_upgrade / $connection_upgrade below survive untouched.

# WebSocket upgrade helper for the /studio IDE proxy (conf.d is http context).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    # 8080: the image is nginxinc/nginx-unprivileged (runs as uid 101,
    # k8s runAsNonRoot-compatible) — non-root can't bind 80.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Backend API (same-origin, mirrors the Vite dev proxy). In k8s the
    # Ingress usually routes /cf straight to the backend Service, but this
    # in-pod path keeps single-container setups (compose) working too.
    location /cf/ {
        proxy_pass http://${BACKEND_HOST}/cf/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE support
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # IDE session proxy (Kubernetes driver). The portal opens
    # /studio/{id}/?token=… in an iframe; the backend reverse-proxies it (and
    # the Theia WebSocket) to the session Pod's Service. Rewritten onto the
    # backend's studio-session proxy route; the session container's own token
    # gate is the auth. Docker deployments never hit this (the portal opens the
    # loopback URL directly), so it is harmless when no k8s sessions exist.
    location /studio/ {
        rewrite ^/studio/(.*)$ /cf/studio-session/v1/ide/$1 break;
        proxy_pass http://${BACKEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
