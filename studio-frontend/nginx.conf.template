# Rendered to /etc/nginx/conf.d/default.conf at container start by the nginx
# image's envsubst step (/etc/nginx/templates/*.template). BACKEND_HOST makes
# the /cf upstream deployment-agnostic: compose sets studio-backend:8090, the
# Helm chart sets <release>-backend:8090. A literal hostname here would make
# nginx REFUSE TO START in any environment where the name doesn't resolve.
# NB envsubst only substitutes DEFINED env vars (BACKEND_HOST), so nginx's own
# $host / $http_upgrade / $connection_upgrade below survive untouched.

# WebSocket upgrade helper for the /studio IDE proxy (conf.d is http context).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}


# Compression. The portal is a JavaScript bundle and nothing here was
# compressing it: every load pulled the whole thing at its uncompressed size,
# on every machine, every time. `gzip_static` is deliberately NOT used — the
# build does not emit `.gz` siblings, and the directive would silently do
# nothing while looking like it did something.
#
# `gzip_vary` matters because a cache sits in front of this in every deployed
# topology (Traefik, then Cloudflare): without it they may hand a compressed
# body to a client that did not ask for one.
gzip on;
gzip_vary on;
gzip_comp_level 5;              # past ~5 the CPU buys almost no extra ratio
gzip_min_length 1024;           # below this the framing costs more than it saves
gzip_proxied any;
gzip_types
    text/plain
    text/css
    text/javascript
    application/javascript
    application/json
    application/manifest+json
    application/wasm
    image/svg+xml
    font/ttf
    font/otf;
# text/html is always compressed when gzip is on and needs no entry above.

# index.html, env.js and each MFE's remoteEntry.js name the current immutable
# bundle, so they must be revalidated after every deployment. Everything under
# an `assets/` directory is Vite-hashed — the host app's own and each MFE's
# (`/mfes/<name>/assets/`), which is why the pattern allows a prefix — so its
# name changes whenever its bytes do and it can be cached forever.
map $uri $frontend_cache_control {
    default                "no-store, no-cache, must-revalidate";
    ~^/(.*/)?assets/       "public, max-age=31536000, immutable";
}

server {
    # 8080: the image is nginxinc/nginx-unprivileged (runs as uid 101,
    # k8s runAsNonRoot-compatible) — non-root can't bind 80.
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback
    location / {
        add_header Cache-Control $frontend_cache_control always;
        try_files $uri $uri/ /index.html;
    }

    # Well-known URIs are asked by programs, never by a person, and the SPA
    # fallback would answer every one of them 200 with the portal's HTML. An
    # MCP client signing in for /cf/studio-mcp asks
    # /.well-known/oauth-authorization-server/auth/realms/studio first (RFC
    # 8414) and must get a 404 to go on to Keycloak's own discovery document.
    location ^~ /.well-known/ {
        try_files $uri =404;
    }


    # Server-sent events, and the one place compression must not reach. The
    # gzip filter buffers until it has enough bytes to be worth compressing,
    # which for a stream that emits one small frame at a time means holding
    # events back for as long as the client is willing to wait. `gzip off`
    # here is what keeps `proxy_buffering off` above meaning anything.
    #
    # A longer prefix wins over `/cf/` in nginx location matching, so this
    # needs no ordering discipline to keep working.
    location /cf/studio-events/v1/stream {
        gzip off;
        proxy_pass http://${BACKEND_HOST};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # Backend API (same-origin, mirrors the Vite dev proxy). In k8s the
    # Ingress usually routes /cf straight to the backend Service, but this
    # in-pod path keeps single-container setups (compose) working too.
    location /cf/ {
        # Analysis submits (studio-spec-quality) POST the whole doc-set as one
        # JSON body; the 1m nginx default would 413 them. The gateway enforces
        # its own per-route limit downstream.
        client_max_body_size 64m;
        proxy_pass http://${BACKEND_HOST}/cf/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE support
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }

    # IDE session proxy (Kubernetes driver). The portal opens
    # /studio/{id}/?token=… in an iframe; the backend reverse-proxies it (and
    # the Theia WebSocket) to the session Pod's Service. Rewritten onto the
    # backend's studio-session proxy route; the session container's own token
    # gate is the auth. Docker deployments never hit this (the portal opens the
    # loopback URL directly), so it is harmless when no k8s sessions exist.
    location /studio/ {
        rewrite ^/studio/(.*)$ /cf/studio-session/v1/ide/$1 break;
        proxy_pass http://${BACKEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 3600s;
    }
}
