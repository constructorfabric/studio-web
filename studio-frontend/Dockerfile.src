# syntax=docker/dockerfile:1.7
# Build the Studio frontend FROM SOURCE (one-click compose path).
# Context = CFS root (matches the backend's Dockerfile.src).
# CI uses ./Dockerfile with a prebuilt dist/ instead.

# node 24 to match .nvmrc and the CI jobs.
FROM node:24-alpine AS build
WORKDIR /src
# The manifests-first layer-cache trick the prototype used does not survive
# npm workspaces: `npm ci` walks every workspace's package.json (packages/*,
# src-app/mfe_packages/*), so the full tree has to be present before install.
COPY studio-frontend/ ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY studio-frontend/nginx.conf.template /etc/nginx/templates/default.conf.template
ENV BACKEND_HOST=studio-backend:8090
COPY --from=build /src/dist/ /usr/share/nginx/html/
COPY studio-frontend/docker/10-runtime-env.sh /docker-entrypoint.d/10-runtime-env.sh
USER root
RUN chmod +x /docker-entrypoint.d/10-runtime-env.sh \
 && touch /usr/share/nginx/html/env.js \
 && chown 101:101 /usr/share/nginx/html/env.js
USER 101
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD wget -q --spider http://127.0.0.1:8080/ || exit 1
