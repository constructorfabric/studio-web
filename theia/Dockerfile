# syntax=docker/dockerfile:1@sha256:ecfaec9ed6d810b56388c508f4121597bfbba70d41a6dfeee4d8cad5f295fc32
# The syntax directive is required for the `RUN --mount=type=secret` below
# (the GitHub token used to resolve the skill engine); everything else in
# this file builds fine on the default frontend.
# Constructor Studio — Theia IDE session image.
#
# Built once, launched per workspace by the studio-session gear:
#   docker build -t cf-studio-theia:latest .
#
# The container serves one Theia session for one workspace mounted at
# /workspace. It has NO authentication of its own (single-user PoC) — the
# session manager publishes the port on loopback only and the portal is the
# front door. Never publish this container's port on a public interface.
#
# Env contract (set by studio-session, all optional):
#   STUDIO_WORKSPACE_ID   stable logical workspace id (audit)
#   STUDIO_ACTOR_ID       audit identity of the launching user
#   STUDIO_MANAGED_WORKSPACE  1 when /workspace is managed by studio-session
#   STUDIO_SOURCES        JSON source list used for clone + canonical manifest
#   STUDIO_GIT_MODE       disabled | commit | push       (default: disabled)
#   STUDIO_GIT_BRANCH     required for commit/push modes
#   STUDIO_REPO_URL       if set and /workspace is empty — cloned on start
#   STUDIO_ALLOWED_ORIGINS — see theia/README.md

# ── Build: bundle browser-app (downloads Theia plugins — needs network) ──
FROM node:22.23.1-bookworm@sha256:5647be709086c696ff32edaaf1c70cd26d1da6ab2b39c32f3c7b4c4a31957e37 AS build
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 make g++ git libsecret-1-dev libx11-dev libxkbfile-dev \
    curl unzip \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json lerna.json .nvmrc ./
COPY studio/ studio/
COPY drawio-editor/ drawio-editor/
COPY product-ext/ product-ext/
COPY gearbox-studio/ gearbox-studio/
# Desktop only (electron-app depends on it), but a workspace: npm ci wants it here.
COPY studio-kits-view/ studio-kits-view/
COPY browser-app/ browser-app/
COPY electron-app/package.json electron-app/package.json
# mermaid-entry.mjs and katex-entry.mjs are the two separate bundles
# browser-app/esbuild.mjs builds; without them in the context the build fails
# on a missing entry point, and without those bundles mermaid-view.js and
# katex-runtime.js have no `mermaid.js` / `katex.js` script to load.
COPY esbuild.mjs gen-esbuild.browser.mjs gen-esbuild.node.mjs mermaid-entry.mjs katex-entry.mjs ./
# patch-package runs from `postinstall`; without patches/ in the build
# context it silently no-ops and the THEIA_CODEX_PATH / THEIA_CLAUDE_CODE_PATH
# overrides in @theia/ai-codex and @theia/ai-claude-code are never applied.
COPY patches/ patches/
# studio/src/node/cfs-map-adapter.ts does a top-level `require()` of
# ../../../.cf-studio/.core/schemas/map.schema.json — i.e. /app/.cf-studio/...
# at runtime. That directory is generated by Constructor Studio and is
# .gitignore'd, so it never reaches the build context and the Theia backend
# dies on boot with MODULE_NOT_FOUND. Ship the canonical schema instead.
COPY docker/cfs-map.schema.json .cf-studio/.core/schemas/map.schema.json
RUN npm ci --ignore-scripts=false
# drawio-editor has no `prepare` script (unlike studio), so `npm ci` doesn't
# compile its lib/ — build it explicitly before bundling the browser app.
RUN npm --prefix drawio-editor run build
# The frontend is minified. Measured on this app (esbuild, same inputs):
# lib/frontend/bundle.js 10 487 027 B unminified vs 5 426 206 B minified
# (1 864 535 B vs 1 431 277 B gzipped), and development mode also emits a
# 15 MB source map into the image. Every cold session pays the difference
# in transfer and, more importantly, in parse time. Build with
# --build-arg STUDIO_BUNDLE_MODE=development for a debuggable image.
ARG STUDIO_BUNDLE_MODE=production
RUN if [ "$STUDIO_BUNDLE_MODE" = development ]; then \
      npm run build:browser:dev; \
    else \
      npm run build:browser; \
    fi

# @openai/codex-sdk vendors six prebuilt binaries and this image runs one.
# Measured on the session image: 223 MB under codex-sdk/vendor, of which 44 MB
# is the platform the container is built for. Trimmed here rather than in the
# runtime stage so the COPY below carries the smaller tree — pruning after the
# copy would leave the weight in the layer that every session pull downloads.
ARG TARGETARCH
RUN --mount=type=bind,source=docker/trim-vendor-binaries.sh,target=/tmp/trim-vendor.sh \
    sh /tmp/trim-vendor.sh "${TARGETARCH:-amd64}" /app/node_modules

# The two assistant extensions, fetched here rather than through
# `theiaPlugins`, because they are the only platform-specific entries we ship
# and that map is a fixed list of URLs. product-ext drives Claude and Codex
# through THESE extensions' commands — `claude-vscode.sidebar.open`,
# `chatgpt.openSidebar`, `chatgpt.addFileToThread` — which nothing else
# registers: @theia/ai-codex and @theia/ai-claude-code provide their own chat,
# not those command ids, so without these the "Ask AI" actions fail with
# "… is not available here".
#
# The prototype pinned darwin-arm64, which cannot run in this container.
# TARGETARCH is set by BuildKit, so an arm64 image gets linux-arm64 and CI's
# amd64 image gets linux-x64 from the same line; an unknown value fails the
# build rather than silently producing an IDE whose assistants do nothing.
ARG TARGETARCH
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
      amd64) vsx_target=linux-x64 ;; \
      arm64) vsx_target=linux-arm64 ;; \
      *) echo "unsupported TARGETARCH '${TARGETARCH}' for the assistant extensions" >&2; exit 1 ;; \
    esac; \
    fetch_vsix() { \
      namespace="$1"; name="$2"; version="$3"; dir="$4"; \
      url="https://open-vsx.org/api/${namespace}/${name}/${vsx_target}/${version}/file/${namespace}.${name}-${version}@${vsx_target}.vsix"; \
      echo "fetching ${dir} (${vsx_target})"; \
      curl -fsSL "$url" -o /tmp/plugin.vsix; \
      mkdir -p "plugins/${dir}"; \
      unzip -q /tmp/plugin.vsix -d "plugins/${dir}"; \
      rm -f /tmp/plugin.vsix; \
    }; \
    fetch_vsix Anthropic claude-code 2.1.227 anthropic.claude-code; \
    fetch_vsix openai chatgpt 26.5803.61601 openai.chatgpt


# Constructor Studio deliberately requires a newer Python patch release than
# Debian Bookworm ships (3.11.2). Build its isolated environment with the
# official Python 3.12 image, then copy that runtime and venv into Theia.
FROM python:3.12-slim-bookworm@sha256:782412e85d0f0984994c290652577d4018aff08145c85b262bb63dc0c7522254 AS cfs
# The pins live in cfs.json, which the desktop build reads too, so a session
# and a desktop run the same validators over the same kit. A build ARG still
# overrides either one.
ARG STUDIO_CFS_REF=
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY cfs.json /opt/cfs-pin.json
RUN ref="${STUDIO_CFS_REF:-$(python3 -c 'import json; print(json.load(open("/opt/cfs-pin.json"))["ref"])')}" \
    && python3 -m venv /opt/cfs \
    && /opt/cfs/bin/pip install --no-cache-dir \
      "git+https://github.com/constructorfabric/studio.git@${ref}" \
    && /opt/cfs/bin/cfs --version

# The pip install above is only HALF of Constructor Studio. `cfs` is a proxy;
# the skill engine it forwards to -- templates, validators, generators -- is a
# separate tarball that `studio_proxy.cache.download_and_cache` fetches from
# GitHub the first time a command needs it. `cfs --version` does not trigger
# that, so without this step the image ships a CLI with nothing behind it and
# the FIRST `cfs kit install` in a session fails with "Constructor Studio skill
# engine not found".
#
# Three reasons to resolve it here rather than at first use:
#
#  * A session Pod's home directory is empty on every start, so the download is
#    not once per image, it is once per session.
#  * It makes GitHub egress a hard requirement for installing a kit, from
#    inside the session Pod, on a cluster where egress is deliberately narrow.
#  * STUDIO_CFS_REF pins the proxy, but the engine resolves to whatever GitHub
#    calls latest AT SESSION TIME. Two sessions a week apart would run
#    different validators over the same pinned kit — which quietly breaks the
#    "pinned to a Git version" promise the Kits page makes.
#
# The proxy and the bundled skill engine must resolve the same cache. The
# current engine resolves it from `$HOME/.cf-studio/cache`, so do not relocate
# it under `/opt`: `cfs init` would otherwise see an empty cache.
ARG STUDIO_CFS_ENGINE=
ENV CFS_CACHE_DIR=/home/node/.cf-studio/cache
# The second command is the one that matters: it asserts the extracted layout
# is the one find_cached_skill() looks for (<cache>/skills/studio/scripts/
# studio.py). A download that succeeds into an unexpected shape is exactly how
# this failed in a live session -- better to fail the build than the user.
# The token is optional and mounted, not an ARG: a build ARG would be baked
# into image history. Without it the resolve call is anonymous against
# api.github.com, whose 60-per-hour-per-IP limit shared runners routinely
# exhaust -- measured: `HTTP Error 403: Forbidden` from a cloud IP. Missing
# secret degrades to exactly that anonymous behaviour rather than failing.
RUN --mount=type=secret,id=github_token \
    engine="${STUDIO_CFS_ENGINE:-$(python3 -c 'import json; print(json.load(open("/opt/cfs-pin.json"))["engine"])')}" \
    && GITHUB_TOKEN="$(cat /run/secrets/github_token 2>/dev/null || true)" \
    /opt/cfs/bin/python -c "import sys; from studio_proxy.cache import download_and_cache; ok, message = download_and_cache(version='${engine}'); print(message); sys.exit(0 if ok else 1)" \
    && /opt/cfs/bin/python -c "import sys; from studio_proxy.resolve import find_cached_skill; entry = find_cached_skill(); print('skill engine entry point:', entry); sys.exit(0 if entry else 1)" \
    && printf '{"engine": "%s"}\n' "${engine}" > /opt/cfs/cfs.json
# That last line records the engine just cached -- the pin, or the
# STUDIO_CFS_ENGINE that overrode it -- where the IDE reads it
# (STUDIO_CFS_PIN below): `cfs init` without `--version` first updates the
# cache to the newest engine on GitHub, so the image's pin held only until
# the first kit install of a session.

# ── Gearbox engine ──
# `gearbox rpc --stdio` serves gearbox-studio: the gear catalogue, products and
# their resolution, and the `.gdl` language (diagnostics, completion, hover). Built
# from source at a pinned commit: the repository publishes no release and no
# crate. Linked against glibc only, so the bookworm build runs on the
# bookworm-slim runtime. Debug info is stripped: 92 MB with it.
FROM rust:1.97.0-bookworm@sha256:8fa55b2f3ddf97471ab6a767bfa3f37e6bad0986ba823e75fea57e2a2a5c3073 AS gearbox
ARG STUDIO_GEARBOX_REPO=https://github.com/constructorfabric/gearbox.git
ARG STUDIO_GEARBOX_REF=55f7015a95f0564ecccb6bbb73fbe586102bce82
WORKDIR /src
RUN git init -q . \
    && git fetch -q --depth 1 "$STUDIO_GEARBOX_REPO" "$STUDIO_GEARBOX_REF" \
    && git checkout -q FETCH_HEAD
RUN CARGO_PROFILE_RELEASE_DEBUG=0 CARGO_PROFILE_RELEASE_STRIP=true \
    cargo build --release --locked -p gearbox-cli \
    && install -m 0755 target/release/gearbox /usr/local/bin/gearbox \
    && gearbox --version

# ── Runtime ──
FROM node:22.23.1-bookworm-slim@sha256:6c74791e557ce11fc957704f6d4fe134a7bc8d6f5ca4403205b2966bd488f6b3
# procps: Theia's process-tree termination shells out to `ps`; without it a
# plugin-host teardown (e.g. after a ws ping timeout) throws an uncaught
# ENOENT that kills the whole backend — the container exits mid-session.
RUN apt-get update && apt-get install -y --no-install-recommends \
    git openssh-client ca-certificates libsecret-1-0 procps \
    && rm -rf /var/lib/apt/lists/*

# Constructor Studio CLI is the sole kit materializer. Copy the Python 3.12
# runtime together with its isolated venv and expose only `cfs` on PATH.
COPY --from=cfs /usr/local/ /usr/local/
COPY --from=cfs /opt/cfs/ /opt/cfs/
# The proxy updates cache provenance before it runs a command. The cache must
# therefore be writable by the non-root `node` session user; otherwise even
# `cfs init` fails before it reaches the project checkout.
COPY --from=cfs --chown=node:node /home/node/.cf-studio/cache/ /home/node/.cf-studio/cache/

# Agent runtimes. Two audiences, and they are not interchangeable.
#
# Theia's own AI providers: neither @theia/ai-codex nor @theia/ai-claude-code
# bundles an executable. The former dynamically imports @openai/codex-sdk
# (which ships no CLI of its own and spawns the `codex` binary), the latter
# resolves @anthropic-ai/claude-agent-sdk from the global npm root — an SDK,
# not a CLI, which is what THEIA_CLAUDE_CODE_PATH points at. Codex CLI is
# pinned to the SDK version resolved in package-lock.json: a mismatched pair
# breaks the wire protocol.
#
# Orca's agents: it runs the agent's CLI as a TUI inside a worktree, so it
# needs `claude` and `opencode` as programs. The claude-agent-sdk above is NOT
# that program — a session offered three agents and two of them answered
# `command not found`. Do not try to serve both audiences from one package:
# the SDK has no CLI and the CLI is not importable as an SDK.
#
# Both read the same keys from the environment (agent_secrets provisions
# OPENAI_API_KEY / ANTHROPIC_API_KEY per user), which is why Theia's chat and
# an Orca terminal act as the same account.
#
# Measured cost of the two CLIs: 558 MB (claude-code 207 MB, opencode-ai
# 353 MB). Their vendored binaries are already single-platform, so
# trim-vendor-binaries.sh has nothing to take off them.
#
# The vendor trim runs in THIS instruction, chained to the install, and that is
# not a style choice. A layer records what its own command left behind: deleting
# a file in a later RUN adds a whiteout and the bytes still ship. Measured with
# random, incompressible data — create 180 MB, delete 120 MB of it:
#
#     delete in a later RUN   217 037 180 B
#     delete in the same RUN    91 168 946 B
#
# The /app trim (build stage, above) is fine where it is for the same reason
# read the other way round: `COPY --from=build` copies the tree as it stands at
# the end, so a separate RUN there costs nothing.
ARG TARGETARCH
RUN --mount=type=bind,source=docker/trim-vendor-binaries.sh,target=/tmp/trim-vendor.sh \
    npm install -g \
      @openai/codex@0.49.0 \
      @anthropic-ai/claude-agent-sdk@0.3.223 \
      @anthropic-ai/claude-code@2.1.266 \
      opencode-ai@1.18.30 \
    && npm cache clean --force \
    && sh /tmp/trim-vendor.sh "${TARGETARCH:-amd64}" /usr/local/lib/node_modules \
    && codex --version && claude --version && opencode --version

# ── Orca runtime (the IDE's Agents panel drives it) ───────────────────────
# Shipped by default. It used to be opt-in, and the result was a session whose
# Agents panel could only report that the runtime was missing — which is what a
# stand showed, because neither the release workflow nor the deployment ever
# passed the build arg. A panel that cannot work by default is not a feature.
#
# The cost is real and measured: 1.25 GB on the image (4.9 GB against 3.7 GB).
# Pinned by version and per-architecture digest, both taken from the release's
# own asset digests — the amd64 one verified against the downloaded package.
# v1.4.198 publishes amd64 and arm64, so TARGETARCH selects the package rather
# than the build being amd64-only.
#
# For a smaller image, at the cost of the panel:
#
#   docker build --build-arg STUDIO_ORCA_VERSION= -t cf-studio-theia:no-orca .
#
# An explicit STUDIO_ORCA_DEB_URL still wins, for a package from somewhere else
# (a mirror, a pre-release); pass its sha256 alongside.
#
# Three things about this package, each found by probing v1.4.197's amd64 deb
# in a container:
#   * the CLI is `orca-ide`, not `orca` — /opt/Orca/resources/bin/orca-ide,
#     linked as /usr/bin/orca-ide;
#   * its Depends are incomplete: without the Electron runtime libraries below
#     the binary does not even load (libasound.so.2 missing);
#   * with them present, `orca-ide status` answers with no display at all —
#     but `orca serve` is a different story: without a display it sometimes
#     initializes X11 anyway and dies ("Missing X server or $DISPLAY … The
#     platform failed to initialize" -> SIGSEGV), reproducibly on a restart.
#     Hence xvfb here, and `xvfb-run` in the entrypoint: three cold starts in
#     a row then reached `state: ready` in 2 s each.
ARG STUDIO_ORCA_VERSION=1.4.198
ARG STUDIO_ORCA_SHA256_AMD64=f0e54c3dbe4ebaa2991b94c7e0e9c5949efe31f46942bbf379075669f7382b6c
ARG STUDIO_ORCA_SHA256_ARM64=0cea17609a834c2b14f237b441b24657abfda505ec5eecd96f38ad607f3e86d8
ARG STUDIO_ORCA_DEB_URL=""
ARG STUDIO_ORCA_DEB_SHA256=""
ARG TARGETARCH
RUN url="$STUDIO_ORCA_DEB_URL"; sha="$STUDIO_ORCA_DEB_SHA256"; \
    arch="${TARGETARCH:-amd64}"; \
    if [ -z "$url" ] && [ -n "$STUDIO_ORCA_VERSION" ]; then \
      case "$arch" in \
        amd64) sha="$STUDIO_ORCA_SHA256_AMD64" ;; \
        arm64) sha="$STUDIO_ORCA_SHA256_ARM64" ;; \
        *) sha="" ;; \
      esac; \
      if [ -n "$sha" ]; then \
        url="https://github.com/stablyai/orca/releases/download/v${STUDIO_ORCA_VERSION}/orca-ide_${STUDIO_ORCA_VERSION}_${arch}.deb"; \
      else \
        echo "orca: no package published for $arch — the panel will say it is not installed"; \
      fi; \
    fi; \
    if [ -n "$url" ]; then \
      set -eux; \
      apt-get update; \
      apt-get install -y --no-install-recommends curl; \
      curl -fsSL --retry 3 -o /tmp/orca.deb "$url"; \
      if [ -n "$sha" ]; then \
        echo "$sha  /tmp/orca.deb" | sha256sum -c -; \
      else \
        echo "orca: installing an unpinned package from $url"; \
      fi; \
      apt-get install -y --no-install-recommends /tmp/orca.deb \
        libasound2 libatk-bridge2.0-0 libatk1.0-0 libatspi2.0-0 libcairo2 \
        libcups2 libdbus-1-3 libdrm2 libexpat1 libgbm1 libglib2.0-0 \
        libgtk-3-0 libnspr4 libnss3 libpango-1.0-0 libx11-6 libxcb1 \
        libxcomposite1 libxdamage1 libxext6 libxfixes3 libxkbcommon0 \
        libxrandr2 xvfb xauth; \
      rm -f /tmp/orca.deb; \
      apt-get purge -y curl; apt-get autoremove -y; \
      rm -rf /var/lib/apt/lists/*; \
      ls -l /usr/bin/orca-ide; \
    else \
      echo "orca: not installed — the Agents panel will say so, and why"; \
    fi

# Non-root: the workspace bind-mount owner should match (uid 1000 = node).
USER node
WORKDIR /app
COPY --from=build --chown=node:node /app /app
COPY --from=gearbox /usr/local/bin/gearbox /usr/local/bin/gearbox
COPY --chown=node:node docker/entrypoint.sh /entrypoint.sh
COPY --chown=node:node docker/materialize-workspace.mjs /usr/local/lib/studio-materialize-workspace.mjs
COPY --chown=node:node docker/git-credentials.mjs /usr/local/lib/studio-git-credentials.mjs
# Wrapper around the codex binary: @theia/ai-codex spawns codex without a
# working directory, so it lands in /app/browser-app (not a git repo) and
# refuses to run. The wrapper forces the session workspace as cwd and passes
# --skip-git-repo-check. THEIA_CODEX_PATH points at it instead of the raw bin.
COPY --chown=node:node docker/codex-studio.sh /usr/local/bin/codex-studio
USER root
# studio_proxy writes its update-check marker and telemetry logs under
# $HOME/.cf-studio (Path.home(), NOT CFS_CACHE_DIR). That directory does not
# exist in a fresh container, so every command opened with "unable to read
# cached update check ... No such file or directory".
RUN chmod +x /usr/local/bin/codex-studio \
    && mkdir -p /home/node/.cf-studio \
    && chown -R node:node /home/node/.cf-studio
USER node

ENV STUDIO_GIT_MODE=disabled \
    STUDIO_DATA_DIR=/home/node/.studio-data \
    PATH=/opt/cfs/bin:$PATH \
    CFS_CACHE_DIR=/home/node/.cf-studio/cache \
    STUDIO_CFS_PIN=/opt/cfs \
    SHELL=/bin/bash \
    THEIA_CODEX_PATH=/usr/local/bin/codex-studio \
    THEIA_CLAUDE_CODE_PATH=/usr/local/lib/node_modules/@anthropic-ai/claude-agent-sdk/sdk.mjs \
    ORCA_CLI=/usr/bin/orca-ide

# Webviews on the application's own origin, instead of Theia's default
# `{{uuid}}.webview.{{hostname}}`.
#
# That default gives every webview an origin of its own, which is the stronger
# arrangement and the reason it IS the default. It also needs a hostname that
# can have subdomains, and neither place this image runs has one. On a loopback
# session the host is an IP, and `<uuid>.webview.127.0.0.1` is not a name at
# all; on the stand `<uuid>.webview.studio-dev-poc.cfabric.org` needs a wildcard
# DNS record and a wildcard certificate, and there are none. So the Claude Code
# and Codex side panels were loading a frame from a host that does not resolve,
# and every session opened on a grey band where a panel should be — measured in
# the browser, in both places, before this line existed.
#
# WHAT IT COSTS, plainly: a webview's script now runs on the application's own
# origin, so it is no longer walled off from the IDE's cookies and storage. The
# webviews here are panels of plugins this image installs itself, the container
# is per-session and ephemeral, and the session gate already serves the webview
# shell on those subdomains (`webviewShellOk` in entrypoint.sh) for the same
# reason. Theia would announce the change in the UI on every open; a person
# using the IDE cannot act on it, so browser-app turns that off
# (`warnOnPotentiallyInsecureHostPattern`) and entrypoint.sh logs it instead.
#
# One ENV, so a deployment that grows wildcard DNS and TLS sets it back to
# `{{uuid}}.webview.{{hostname}}` and loses nothing else.
ENV THEIA_WEBVIEW_EXTERNAL_ENDPOINT="{{hostname}}"

VOLUME ["/workspace"]
EXPOSE 3003

# bash-wrapped: survives a lost exec bit on Windows checkouts
ENTRYPOINT ["/bin/bash", "/entrypoint.sh"]
