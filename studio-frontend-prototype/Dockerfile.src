# syntax=docker/dockerfile:1.7@sha256:e87caa74dcb7d46cd820352bfea12591f3dba3ddc4285e19c7dcd13359f7cefd
# Build the Studio frontend FROM SOURCE (one-click compose path).
# Context = CFS root (matches the backend's Dockerfile.src).
# CI uses ./Dockerfile with a prebuilt dist/ instead.

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS build
WORKDIR /src
COPY studio-frontend-prototype/package.json studio-frontend-prototype/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --no-audit --no-fund
COPY studio-frontend-prototype/ ./
# The /architecture/ page's prototype map is read from src/ at build time by
# vite.config.ts, with the reader the API-usage check uses (../scripts here).
COPY scripts/api-usage-lib.mjs scripts/prototype-api-map.mjs scripts/prototype-api-map.d.mts /scripts/
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.27-alpine@sha256:65e3e85dbaed8ba248841d9d58a899b6197106c23cb0ff1a132b7bfe0547e4c0
COPY studio-frontend-prototype/nginx.conf.template /etc/nginx/templates/default.conf.template
ENV BACKEND_HOST=studio-backend:8090
COPY --from=build /src/dist/ /usr/share/nginx/html/
COPY studio-frontend-prototype/docker/10-runtime-env.sh /docker-entrypoint.d/10-runtime-env.sh
USER root
RUN chmod +x /docker-entrypoint.d/10-runtime-env.sh \
 && touch /usr/share/nginx/html/env.js \
 && chown 101:101 /usr/share/nginx/html/env.js
USER 101
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=3s --retries=5 \
  CMD wget -q --spider http://127.0.0.1:8080/ || exit 1
